<% layout("/layouts/boilerplate.ejs") -%>
<div>
    <div class="w-8/12 mx-auto">
        <br>    
        <h1>Edit your listing</h1>
        <br>
        <form method="POST" action="/listings/<%=listings._id%>?_method=PUT">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input name="title" value="<%=listings.title%>" type="text" class="form-control"/>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="description" type="text" class="form-control"><%=listings.description%></textarea>
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Image URL</label>
                <input name="image" value="<%=listings.image%>" type="text" class="form-control"/>
            </div>

            <div class="flex flex-col gap-4 sm:flex-row">
                <div class="mb-3 w-full sm:w-1/3">
                    <label for="price" class="form-label">Price</label>
                    <input name="price" value="<%=listings.price%>" type="number" class="form-control"/>
                </div>
                <div class="mb-3 flex-1">
                    <label for="country" class="form-label">Country</label>
                    <input name="country" value="<%=listings.country%>" type="text" class="form-control"/>
                </div>
            </div>
            
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input name="location" value="<%=listings.location%>" type="text" class="form-control"/>
            </div>
            <br>
            <button class="edit-btn">Edit</button>
            <br><br>
        </form>
    </div>
</div>