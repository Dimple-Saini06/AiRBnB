<% layout("/layouts/boilerplate.ejs") -%>
<body>
    <div class="mx-auto flex flex-col items-center">
        <div class="w-full max-w-xl translate-x-8">
            <h1 class="mb-4 text-center">Listing Details</h1>
            <img 
                src="<%= listing.image %>" 
                class="show-img h-[20rem] w-full rounded-xl object-cover" 
                alt="listing_image"
            />
            <div class="card-body flex flex-col justify-center items-center">
                <p class="card-text font-medium">
                    <b><%= listing.title %></b> <br />
                    <%= listing.description %> <br/>
                    &#8377; <%= listing.price.toLocaleString("en-IN") %> /night <br />
                    <%= listing.location %> <br />
                    <%= listing.country %> <br />
                </p>
            </div>
        </div>
        <!-- <br> -->
        <!-- <div> -->
            <div class="mt-2 mb-3 flex justify-center items-center gap-10">
                <a href="/listings/<%=listing._id%>/edit" class="edit-post">Edit</a>
                <form method="POST" action="/listings/<%=listing.id%>?_method=DELETE" >
                    <button class="rounded-md bg-gray-900 px-4 py-2 text-white hover:bg-gray-800">Delete</button>
                </form>
            </div>
        <!-- </div>
        <br> -->
    </div>
    
</body>
