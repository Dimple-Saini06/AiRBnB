<%- layout("/layouts/boilerplate.ejs") %>
<div>
    <div class="w-8/12 mx-auto">
        <br>
        <h1>Create a list</h1>
        <br>
        <form method="POST" action="/listings">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input name="title" placeholder="Add catchy title" type="text" class="form-control"/>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="description" type="text" class="form-control"></textarea>
            </div>
            
            <div class="mb-3">
                <label for="image" class="form-label">Image URL</label>
                <input name="image" placeholder="enter image URL/Link" type="text" class="form-control" />
            </div>

            <div class="flex flex-col gap-4 sm:flex-row">
                <div class="mb-3 w-full sm:w-1/3">
                    <label for="price" class="form-label">Price</label>
                    <input name="price" placeholder="1200" type="number" class="form-control" />
                </div>
                
                <div class="mb-3 flex-1">
                    <label for="country" class="form-label">Country</label>
                    <input name="country" placeholder="India" type="text" class="form-control" />
                </div>
            </div>
            
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input name="location" placeholder="Jaipur, Rajasthan" type="text" class="form-control" />
            </div>
            <br><br>
            <button class="add-btn rounded-md px-4 py-2 text-white">Add</button>
            <br></br>

        </form>
    </div>
</div>
